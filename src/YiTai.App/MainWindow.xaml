<!-- ============================================================
     MainWindow.xaml —— 译台主窗口
     ============================================================
     结构（按软件的标准来，不做"向导式"的怪东西）：
       菜单栏：文件（新建/打开/保存/另存为/导入源文件/退出）、帮助
       左栏：源文件选择 + 整篇原文（只读、可选中复制）
       右栏：整篇译文编辑区（所见即所存）

     ★ 界面不认识"注解""切句""章节"这些概念。它只拿两样东西：
       一份源文件全文、一份译文全文。以后要加章节树、双语对照、
       术语提示，都挂到侧边或新的面板上，不动这两块。

     ★ 左侧刻意用等宽字、不做句级高亮：原文是给你读和复制用的，
       不是待办清单。逐句高亮属于"阅读器"，等真需要时再加一层。
     ============================================================ -->
<Window x:Class="YiTai.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="译台"
        Width="1280" Height="860"
        MinWidth="900" MinHeight="560"
        Background="{DynamicResource BgDeep}"
        Foreground="{DynamicResource TextMain}"
        FontFamily="Microsoft YaHei"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ======================================================== 菜单 -->
        <Menu Grid.Row="0" Background="{DynamicResource BgCard}" Padding="4,2"
              BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
            <MenuItem Header="文件(_F)">
                <MenuItem Header="新建项目…" InputGestureText="Ctrl+N" Click="OnNewProject"/>
                <MenuItem Header="打开项目…" InputGestureText="Ctrl+O" Click="OnOpenProject"/>
                <Separator/>
                <MenuItem x:Name="MiSave" Header="保存" InputGestureText="Ctrl+S" Click="OnSave"/>
                <MenuItem x:Name="MiSaveAs" Header="另存为…" Click="OnSaveAs"/>
                <Separator/>
                <MenuItem x:Name="MiImport" Header="导入源文件…" Click="OnImport"/>
                <MenuItem x:Name="MiLink" Header="关联已有译文…" Click="OnLinkTranslations"/>
                <Separator/>
                <MenuItem Header="退出" Click="OnExit"/>
            </MenuItem>
            <MenuItem Header="帮助(_H)">
                <MenuItem Header="项目文件夹里有什么？" Click="OnExplainLayout"/>
                <MenuItem Header="关于译台" Click="OnAbout"/>
            </MenuItem>
        </Menu>

        <!-- ======================================================== 项目条 -->
        <Border Grid.Row="1" Background="{DynamicResource BgCard}"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"
                Padding="14,9">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="BtnSave" Content="保存" Style="{StaticResource BtnAccent}"
                            Click="OnSave" Margin="0,0,8,0"/>
                    <Button x:Name="BtnImport" Content="导入源文件" Style="{StaticResource Btn}"
                            Click="OnImport" Margin="0,0,8,0"/>
                    <Button x:Name="BtnOpen" Content="打开项目" Style="{StaticResource Btn}"
                            Click="OnOpenProject"/>
                </StackPanel>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtProject" Text="还没有打开项目" FontSize="14.5" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtProjectPath" Text="文件 → 新建项目 / 打开项目"
                               FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFaint}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ======================================================== 双栏 -->
        <Grid Grid.Row="2" Margin="12,12,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="46*" MinWidth="260"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="54*" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <!-- 左：原文 -->
            <Border Grid.Column="0" Background="{DynamicResource BgCard}"
                    BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="14,10,10,8"
                            BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="原文" FontSize="12.5"
                                       VerticalAlignment="Center" Margin="0,0,10,0"
                                       Foreground="{DynamicResource TextDim}"/>
                            <TextBlock x:Name="TxtSourceInfo" DockPanel.Dock="Right" FontSize="11"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFaint}"/>
                            <ComboBox x:Name="CmbSources" FontSize="12.5" IsEnabled="False"
                                      SelectionChanged="OnSourceChanged"
                                      ToolTip="项目里导入的源文件"/>
                        </DockPanel>
                    </Border>

                    <!-- 整篇原文：只读、可选中、Ctrl+C 复制 -->
                    <TextBox x:Name="TbxSource" IsReadOnly="True" BorderThickness="0"
                             Background="Transparent" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                             FontFamily="Consolas" FontSize="13.5" Padding="14,10,12,16"
                             Foreground="{DynamicResource TextMain}"
                             TextBlock.LineHeight="24"/>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Style="{StaticResource SplitterThin}" ResizeBehavior="PreviousAndNext"/>

            <!-- 右：译文 -->
            <Border Grid.Column="2" Background="{DynamicResource BgCard}"
                    BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="14,10,10,8"
                            BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="译文" FontSize="12.5"
                                       VerticalAlignment="Center" Margin="0,0,10,0"
                                       Foreground="{DynamicResource TextDim}"/>
                            <TextBlock x:Name="TxtTrPath" DockPanel.Dock="Right" FontSize="11"
                                       TextTrimming="CharacterEllipsis" MaxWidth="420"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFaint}" HorizontalAlignment="Right"/>
                            <TextBlock Text="所见即所存" FontSize="11"
                                       Foreground="{DynamicResource TextFaint}" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </Border>

                    <TextBox x:Name="TbxTranslation" Style="{StaticResource DocBox}"
                             IsEnabled="False" TextChanged="OnTranslationChanged"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ======================================================== 状态栏 -->
        <Border Grid.Row="3" Background="{DynamicResource BgCard}"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"
                Padding="14,6">
            <DockPanel>
                <TextBlock x:Name="TxtSaveState" DockPanel.Dock="Right" FontSize="11.5"
                           Foreground="{DynamicResource TextFaint}"/>
                <TextBlock x:Name="TxtStat" FontSize="11.5" Foreground="{DynamicResource TextDim}"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
