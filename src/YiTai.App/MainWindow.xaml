<!-- ============================================================
     MainWindow.xaml —— 译台主窗口
     ============================================================
     结构（按软件的标准来，不做"向导式"的怪东西）：
       菜单栏：文件（新建/打开/保存/另存为/导入源文件/退出）、帮助
       左栏：源文件选择 + 整篇资料（只读、可选中复制）
       右栏：整篇译文编辑区（所见即所存）

     ★ 界面不认识"注解""切句""章节"这些概念。它只拿两样东西：
       一份源文件全文、一份译文全文。以后要加章节树、双语对照、
       术语提示，都挂到侧边或新的面板上，不动这两块。

     ★ 左侧刻意用等宽字、不做句级高亮：资料是给你读和复制用的，
       不是待办清单。逐句高亮属于"阅读器"，等真需要时再加一层。
     ============================================================ -->
<Window x:Class="YiTai.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="译台"
        Icon="Assets/App.ico"
        Width="1280" Height="860"
        MinWidth="900" MinHeight="560"
        Background="{DynamicResource BgDeep}"
        Foreground="{DynamicResource TextMain}"
        FontFamily="Microsoft YaHei"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ======================================================== 菜单 -->
        <Menu Grid.Row="0" Background="{DynamicResource BgCard}" Padding="4,2"
              BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
            <MenuItem Header="文件(_F)">
                <MenuItem Header="新建项目…" InputGestureText="Ctrl+N" Click="OnNewProject"/>
                <MenuItem Header="打开项目…" InputGestureText="Ctrl+O" Click="OnOpenProject"/>
                <Separator/>
                <MenuItem x:Name="MiSave" Header="保存" InputGestureText="Ctrl+S" Click="OnSave"/>
                <MenuItem x:Name="MiSaveAs" Header="给这篇译文改名…" Click="OnSaveAs"/>
                <Separator/>
                <MenuItem x:Name="MiNewTrans" Header="新建译文…" InputGestureText="Ctrl+Shift+N" Click="OnNewTranslation"/>
                <MenuItem x:Name="MiImportTrans" Header="把已有文件收进来当译文…" Click="OnImportTranslation"/>
                <MenuItem x:Name="MiOpenRef" Header="打开文件看（只读）…" Click="OnOpenRefFile"/>
                <Separator/>
                <MenuItem Header="退出" Click="OnExit"/>
            </MenuItem>
            <MenuItem Header="帮助(_H)">
                <MenuItem Header="项目文件夹里有什么？" Click="OnExplainLayout"/>
                <MenuItem Header="关于译台" Click="OnAbout"/>
            </MenuItem>
        </Menu>

        <!-- ======================================================== 项目条 -->
        <Border Grid.Row="1" Background="{DynamicResource BgCard}"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"
                Padding="14,9">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="BtnNewTrans" Content="＋ 新建译文" Style="{StaticResource Btn}"
                            Click="OnNewTranslation" Margin="0,0,8,0"
                            ToolTip="不用先有资料：起个名字就能开始写，译文统一落在 translations 里"/>
                    <Button x:Name="BtnAddPane" Content="＋ 对照栏" Style="{StaticResource Btn}"
                            Click="OnAddPane" Margin="0,0,8,0"
                            ToolTip="再加一栏：任何文件都能放进来，只读，不会进项目"/>
                    <Button x:Name="BtnSave" Content="保存" Style="{StaticResource BtnAccent}"
                            Click="OnSave" Margin="0,0,8,0"/>
                    <Button x:Name="BtnOpenFile" Content="打开文件" Style="{StaticResource Btn}"
                            Click="OnOpenRefFile" Margin="0,0,8,0"
                            ToolTip="打开任何文件当对照资料（只读，不复制、不改项目）"/>
                    <Button x:Name="BtnOpen" Content="打开项目" Style="{StaticResource Btn}"
                            Click="OnOpenProject"/>
                </StackPanel>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtProject" Text="还没有打开项目" FontSize="14.5" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtProjectPath" Text="文件 → 新建项目 / 打开项目"
                               FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFaint}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ======================================================== 多栏对照 -->
        <!--
            列由代码填（MainWindow.Panes.cs）：
              第 0、2、4… 列 = 对照栏（资料 / 别的语言的译文 / PDF 原件；可增减、可左右调）
              每两栏之间夹一条可拖的分隔条
              最右一列 = 译文栏，钉死，只有它能写

            译文栏写在 XAML 里而不是代码里，是因为它的自动保存、冲突处理
            都钉在这几个控件上（TbxTranslation / CmbSources），动态生成反而更脆。
        -->
        <Grid x:Name="PanesGrid" Grid.Row="2" Margin="12,12,12,0">

            <!-- 译文：永远最右 -->
            <Border x:Name="TransPane" Background="{DynamicResource BgCard}"
                    BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="14,9,10,8"
                            BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="TxtTrPath" FontSize="11" MaxWidth="300"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFaint}"/>
                                <Button x:Name="BtnPreview" Content="预览" Style="{StaticResource BtnMini}"
                                        Click="OnTogglePreview" Margin="6,0,0,0"
                                        ToolTip="把译文按 Markdown 样式渲染出来看；再点一下回到编辑"/>
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Left" Text="译文" FontSize="12.5"
                                       VerticalAlignment="Center" Margin="0,0,10,0"
                                       Foreground="{DynamicResource TextDim}"/>
                            <ComboBox x:Name="CmbSources" FontSize="12.5" IsEnabled="False"
                                      SelectionChanged="OnSourceChanged"
                                      ToolTip="切换译文（这里只列译文，不列资料）"/>
                        </DockPanel>
                    </Border>

                    <!-- 译文文件不在了：不弹窗，就在编辑区上方说清楚，并给出三条路 -->
                    <Border x:Name="MissingTransBar" DockPanel.Dock="Top" Visibility="Collapsed"
                            Background="{DynamicResource BgCardAlt}"
                            BorderBrush="{DynamicResource Warn}" BorderThickness="0,0,0,2"
                            Padding="12,8">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Button Content="重新指定…" Style="{StaticResource BtnMini}"
                                        Click="OnRelocateTranslation" Margin="10,0,6,0"
                                        ToolTip="选一份现有的稿子，复制过来放到它原来的位置"/>
                                <Button Content="在这里新建空稿" Style="{StaticResource BtnMini}"
                                        Click="OnCreateMissingTranslation" Margin="0,0,6,0"
                                        ToolTip="按原来的文件名建一份空文件，从头写"/>
                                <Button Content="先只读" Style="{StaticResource BtnMini}"
                                        Click="OnDismissMissingTranslation" Margin="0,0,4,0"
                                        ToolTip="什么都别动，就把它当只读的旧稿看"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtMissingTrans" FontSize="11.5" TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Warn}"/>
                        </DockPanel>
                    </Border>

                    <!-- 底部：实时字数（编辑区、选中都算） -->
                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}"
                            BorderThickness="0,1,0,0" Padding="14,4">
                        <TextBlock x:Name="TxtTrStat" FontSize="11.5"
                                   Foreground="{DynamicResource TextDim}"/>
                    </Border>

                    <!-- 编辑区和预览叠在同一格里：只切可见性，文本一直留在 TextBox 里，切来切去不会丢 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 行号栏：像代码编辑器一样，钉在译文左侧，只读、不抢焦点 -->
                        <Border x:Name="LineNumPanel" Grid.Column="0"
                                Background="{DynamicResource BgCardAlt}"
                                BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
                            <TextBox x:Name="LineNumGutter" Style="{StaticResource LineNumBox}"
                                     VerticalAlignment="Stretch"/>
                        </Border>

                        <TextBox x:Name="TbxTranslation" Grid.Column="1" Style="{StaticResource DocBox}"
                                 IsEnabled="False" TextChanged="OnTranslationChanged"
                                 SelectionChanged="OnTranslationSelectionChanged"/>
                        <FlowDocumentScrollViewer x:Name="PreviewDoc" Grid.Column="0" Grid.ColumnSpan="2"
                                                  Visibility="Collapsed"
                                                  IsToolBarVisible="False" IsSelectionEnabled="True"
                                                  Background="{DynamicResource BgCard}"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"/>

                        <!-- 一篇译文都没有时：这里就不是一块死灰，直接给个能按的按钮 -->
                        <StackPanel x:Name="EmptyTrans" Grid.Column="0" Grid.ColumnSpan="2"
                                    Visibility="Collapsed"
                                    VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Margin="24" MaxWidth="340">
                            <TextBlock x:Name="TxtEmptyTitle" Text="这个项目还没有译文"
                                       FontSize="13.5" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" TextWrapping="Wrap"/>
                            <TextBlock x:Name="TxtEmptyHint"
                                       Text="不用先有资料 —— 起个名字就能开始写。译文统一落在项目的 translations 文件夹里。"
                                       FontSize="11.5" Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="18"
                                       Foreground="{DynamicResource TextFaint}"
                                       HorizontalAlignment="Center" TextAlignment="Center"/>
                            <Button x:Name="BtnEmptyNewTrans" Content="＋ 新建一篇译文"
                                    Style="{StaticResource BtnAccent}" Margin="0,14,0,0"
                                    HorizontalAlignment="Center" Click="OnNewTranslation"/>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ======================================================== 状态栏 -->
        <Border Grid.Row="3" Background="{DynamicResource BgCard}"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"
                Padding="14,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtMissingCount" FontSize="11.5" Margin="0,0,14,0"
                               Foreground="{DynamicResource Warn}" Visibility="Collapsed"
                               Cursor="Hand" MouseLeftButtonUp="OnShowMissingList"/>
                    <TextBlock x:Name="TxtSaveState" FontSize="11.5"
                               Foreground="{DynamicResource TextFaint}"/>
                </StackPanel>
                <TextBlock x:Name="TxtStat" FontSize="11.5" Foreground="{DynamicResource TextDim}"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
