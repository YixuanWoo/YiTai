<!-- ============================================================
     Theme.xaml —— 令牌 + 控件样式（浅色，跟"工作台"同一套色板）
     ============================================================
     配色直接取自 Workbench\Theming\Theme.cs 的现有值，不另起一套：
       底 #EEF2F7 · 页 #F4F7FA · 导航 #E8EEF5 · 卡片白
       文字 #1F2933 / #5A6B7D / #8394A6 · 描边 #D7DFE9
       强调蓝 #2563EB · 选中 #E3EEFB · 悬停 #F0F4F9
     另外补两个语义色（原主题里没有）：
       译完 = 绿 #2E9E5B（进度用，不能跟"强调蓝"抢注意力）
       警告 = 暗橙 #C2410C（未保存 / 冲突）

     ★ 不用自绘控件：全部基于原生 ScrollBar / Button / TextBox 改模板，
       这样系统主题、无障碍、HiDPI 都由框架负责。
     ============================================================ -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:app="clr-namespace:YiTai.App">

    <!-- 细进度条要用：Value/Maximum → 像素宽度 -->
    <app:PercentWidth x:Key="PercentWidth"/>

    <!-- ========================================================== 颜色 -->
    <Color x:Key="BgDeepColor">#FFEEF2F7</Color>
    <Color x:Key="LineColor">#FFD7DFE9</Color>
    <Color x:Key="AccentColor">#FF2563EB</Color>
    <Color x:Key="DoneColor">#FF2E9E5B</Color>
    <Color x:Key="WarnColor">#FFC2410C</Color>

    <SolidColorBrush x:Key="BgDeep" Color="#FFEEF2F7"/>
    <SolidColorBrush x:Key="BgShell" Color="#FFF4F7FA"/>
    <SolidColorBrush x:Key="BgNav" Color="#FFE8EEF5"/>
    <SolidColorBrush x:Key="BgCard" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="BgCardAlt" Color="#FFF6F9FC"/>
    <SolidColorBrush x:Key="BgWrite" Color="#FFFDFDFB"/>

    <SolidColorBrush x:Key="TextMain" Color="#FF1F2933"/>
    <SolidColorBrush x:Key="TextDim" Color="#FF5A6B7D"/>
    <SolidColorBrush x:Key="TextFaint" Color="#FF8394A6"/>

    <SolidColorBrush x:Key="Line" Color="#FFD7DFE9"/>
    <SolidColorBrush x:Key="Accent" Color="#FF2563EB"/>
    <SolidColorBrush x:Key="AccentHot" Color="#FF1D4ED8"/>
    <SolidColorBrush x:Key="ItemSelBg" Color="#FFE3EEFB"/>
    <SolidColorBrush x:Key="ItemHoverBg" Color="#FFF0F4F9"/>
    <SolidColorBrush x:Key="SelBrush" Color="#4D2563EB"/>

    <SolidColorBrush x:Key="Done" Color="#FF2E9E5B"/>
    <SolidColorBrush x:Key="DoneBg" Color="#FFFAFDFB"/>
    <SolidColorBrush x:Key="DoneLine" Color="#FFCBE8D6"/>
    <SolidColorBrush x:Key="Warn" Color="#FFC2410C"/>

    <!-- ========================================================== 滚动条 -->
    <!-- 原生滚动条在浅色 UI 里太粗太抢眼：收成 8px，Track 透明，只留一个圆角 Thumb，
         悬停时淡入强调蓝（不是瞬间变，用 ColorAnimation）。 -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="9"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <!-- 本地画笔：动画要改它的颜色，不能引用全局那支笔 -->
                                            <Border x:Name="Bar" CornerRadius="4" Margin="2,3,2,3">
                                                <Border.Background>
                                                    <SolidColorBrush Color="#FFC6D2DF"/>
                                                </Border.Background>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <ColorAnimation Storyboard.TargetName="Bar"
                                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                                To="{StaticResource AccentColor}" Duration="0:0:0.2"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <ColorAnimation Storyboard.TargetName="Bar"
                                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                                To="#FFC6D2DF" Duration="0:0:0.2"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================================== 按钮 -->
    <Style x:Key="Btn" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
        <Setter Property="Background" Value="{DynamicResource BgCard}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="6"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ItemHoverBg}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ItemSelBg}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 行内小按钮（"复" / "注⌄"）：无边框，只有悬停底 -->
    <Style x:Key="BtnMini" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Padding" Value="7,3"/>
        <Setter Property="MinWidth" Value="26"/>
    </Style>

    <!-- 主按钮（保存）：强调蓝 -->
    <Style x:Key="BtnAccent" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="{DynamicResource Accent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHot}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================================== 译文输入框 -->
    <!-- 圆角 + 内描边：TextBox 自己要圆角必须换模板；PART_ContentHost 必须留名，
         否则滚动与 IME 都会出问题。 -->
    <Style x:Key="ZhBox" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource BgWrite}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
        <Setter Property="FontFamily" Value="Microsoft YaHei"/>
        <Setter Property="FontSize" Value="14.5"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="AcceptsReturn" Value="True"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" CornerRadius="6"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource Line}"
                            BorderThickness="1" Padding="10,7">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      VerticalScrollBarVisibility="Disabled"
                                      HorizontalScrollBarVisibility="Disabled"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgCardAlt}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================================== 整篇编辑区 -->
    <!-- 右边那一整块；边界由外层卡片负责，所以这里无边框、透明底 -->
    <Style x:Key="DocBox" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
        <Setter Property="FontFamily" Value="Microsoft YaHei"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="TextBlock.LineHeight" Value="29"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="AcceptsReturn" Value="True"/>
        <Setter Property="AcceptsTab" Value="True"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="Padding" Value="18,8,14,18"/>
    </Style>

    <!-- ========================================================== 行号栏 -->
    <!-- 和 DocBox 必须同字体、同字号、同行高、同上下内边距，滚动时才能逐行对齐；
         它自己不换行、不滚动条、不抢焦点，只是一个会跟着译文滚的数字条。 -->
    <Style x:Key="LineNumBox" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFaint}"/>
        <Setter Property="FontFamily" Value="Microsoft YaHei"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="TextBlock.LineHeight" Value="29"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Hidden"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Hidden"/>
        <Setter Property="TextAlignment" Value="Right"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Padding" Value="10,8,10,18"/>
    </Style>

    <!-- ========================================================== 分栏拖手 -->
    <Style x:Key="SplitterThin" TargetType="GridSplitter">
        <Setter Property="Width" Value="7"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="SizeWE"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridSplitter">
                    <Border Background="Transparent">
                        <!-- 本地画笔：下面的动画要改它 -->
                        <Border x:Name="Bar" Width="2" HorizontalAlignment="Center" Margin="0,10,0,10">
                            <Border.Background>
                                <SolidColorBrush Color="{StaticResource LineColor}"/>
                            </Border.Background>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Bar"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="{StaticResource AccentColor}" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Bar"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="{StaticResource LineColor}" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================================== 章节目录项 -->
    <Style x:Key="ChapterItem" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,0,3"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                            BorderBrush="Transparent" BorderThickness="3,0,0,0" Padding="8,6">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ItemHoverBg}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ItemSelBg}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================================== 细进度条 -->
    <Style x:Key="ThinBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="3"/>
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border Background="#FFDCE4EE" CornerRadius="2"/>
                        <Border x:Name="PART_Track"/>
                        <Border Background="{DynamicResource Done}" CornerRadius="2">
                            <Border.Width>
                                <MultiBinding Converter="{StaticResource PercentWidth}">
                                    <Binding Path="Value" RelativeSource="{RelativeSource TemplatedParent}"/>
                                    <Binding Path="Maximum" RelativeSource="{RelativeSource TemplatedParent}"/>
                                    <Binding Path="ActualWidth" RelativeSource="{RelativeSource TemplatedParent}"/>
                                </MultiBinding>
                            </Border.Width>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
