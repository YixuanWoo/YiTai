<Project Sdk="Microsoft.NET.Sdk">

  <!-- ============================================================
       YiTai.App —— 界面层（WPF，Windows only）
       ============================================================
       为什么是 WPF 而不是 WinForms：
         · 用户自己工程里的「写作台」模块就是 WPF，骨架能直接搬
           （三行外壳 + 目录/编辑/可拖分栏 的布局习惯）；
         · 原生支持 HiDPI 与 ClearType，中文长文本读起来比
           手写设备的 WinForms 舒服；
         · ItemsControl + DataTemplate 天然适合"一句一行"这种重复结构。

       还可以考虑 Windows 上的 .NET 桌面框架没有第三个选项值得换。
       ============================================================ -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>YiTai.App</RootNamespace>
    <AssemblyName>YiTai</AssemblyName>
    <Version>0.1.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- exe 文件、任务栏、资源管理器里显示的图标（T-6） -->
    <ApplicationIcon>Assets\App.ico</ApplicationIcon>
    <!-- 单文件自包含发布时用不到，但本地 F5 调试时能少一堆告警 -->
    <SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\YiTai.Core\YiTai.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 图标既是 exe 的窗口资源，也要能作为 WPF 资源给标题栏用 -->
    <Resource Include="Assets\App.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

</Project>
