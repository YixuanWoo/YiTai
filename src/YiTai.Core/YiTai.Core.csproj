<Project Sdk="Microsoft.NET.Sdk">

  <!-- ============================================================
       YiTai.Core —— 纯逻辑层（切句 / 读写 / 备份 / 冲突检测）
       ============================================================
       刻意不带任何 UI 依赖（TargetFramework 是 net10.0，不是
       net10.0-windows），原因有三：
         1. 这一层能被单元测试直接跑，不用起窗口；
         2. 将来如果要换壳（WinForms / Avalonia / 命令行），只换 UI；
         3. 开源协作者改逻辑时，不会碰到界面代码。

       本文件平时不用改；只有加第三方库时才需要动。
       ============================================================ -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>YiTai.Core</RootNamespace>
    <AssemblyName>YiTai.Core</AssemblyName>
    <Nullable>enable</Nullable>
    <!-- 每个文件手写 using，方便别人（和自己）看清依赖了什么 -->
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- 这里**故意没有**任何 NuGet 依赖（曾经有 PdfPig，用来抽 PDF 文字层，已删 —— 见 T-12）。
       零依赖是刻意的：单文件 exe 不再带第三方 dll，开源协作者 clone 下来只有 .NET 本身。
       如果哪天要做「PDF 文字模式」（见 docs\TODO.md 的"将来可能做"），再加回来。 -->

</Project>
